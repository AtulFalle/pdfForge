{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "framework": "angular",
      "root": "web/",
      "installCommand": "pnpm install --frozen-lockfile",
      "buildCommand": "pnpm run build",
      "outputDirectory": "dist/web/browser",
      "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/scripts/vercel-ignore.sh\""
    },
    "api": {
      "runtime": "container",
      "root": "server/",
      "entrypoint": "Dockerfile.vercel",
      "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/scripts/vercel-ignore.sh\""
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/ready", "destination": { "service": "api" } },
    { "source": "/swagger-ui", "destination": { "service": "api" } },
    { "source": "/swagger-ui/(.*)", "destination": { "service": "api" } },
    { "source": "/api-docs/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
